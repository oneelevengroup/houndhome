---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LineIcon from '../../components/LineIcon.astro';
import CTASection from '../../components/CTASection.astro';
import { pillars, programsByPillar } from '../../data/services';

const philosophy = [
  'Breed-fulfilling activities',
  'One-on-one training time',
  'Hikes and trail walks',
  'An evening brush-out',
  'Homemade treats',
  'A clean, calm place to rest',
];

// Service schema for SEO (§8)
const serviceSchema = pillars.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${p.word} — ${p.title}`,
  description: p.summary,
  provider: { '@type': 'LocalBusiness', name: 'Hound & Home' },
  areaServed: 'Ararat, VA and the Mount Airy region',
}));
---

<BaseLayout
  title="Services"
  description="Structured, enriching care that actually fits your dog. Play, Stay, and Train programs from a trainer with thirteen years of experience."
  schema={serviceSchema}
>
  <PageHero
    eyebrow="Play · Stay · Train"
    title="Care that actually fits your dog."
    intro="Every dog who stays here gets more than a place to sleep. Days are structured and enriching, never a free-for-all. It is a real home where good habits are built and kept. Explore how your dog can play, stay, and train with us."
  />

  <!-- Philosophy band -->
  <section class="px-5 pt-14 sm:px-8 sm:pt-20">
    <div class="reveal mx-auto max-w-5xl rounded-[2rem] bg-sage-soft/50 px-6 py-10 sm:px-12 sm:py-12">
      <p class="label-caps text-teal">A day here looks like</p>
      <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          philosophy.map((item) => (
            <li class="flex items-center gap-3 text-body text-ink/80">
              <LineIcon name="leaf" class="h-5 w-5 shrink-0 text-sage" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pillars + programs -->
  {
    pillars.map((pillar) => {
      const items = programsByPillar(pillar.key);
      return (
        <section id={pillar.key} class="scroll-mt-24 px-5 pt-16 sm:px-8 sm:pt-24">
          <div class="mx-auto max-w-5xl">
            <div class="reveal flex flex-wrap items-end justify-between gap-4 border-b border-ink/10 pb-5">
              <div class="flex items-center gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sage-soft/70">
                  <LineIcon name={pillar.icon} class="h-6 w-6 text-teal" />
                </span>
                <div>
                  <h2 class="font-display text-h1 text-teal">{pillar.word}</h2>
                  <p class="text-caption font-semibold uppercase tracking-wide text-sage">
                    {pillar.title}
                  </p>
                </div>
              </div>
              {pillar.status === 'soon' && (
                <span class="label-caps rounded-full bg-camel/15 px-3 py-1 text-camel">
                  Coming soon
                </span>
              )}
            </div>

            <p class="reveal mt-5 max-w-prose text-body text-ink/75">{pillar.summary}</p>

            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              {items.map((program) => (
                <a
                  href={`/services/${program.slug}`}
                  class="reveal group flex flex-col rounded-2xl border border-ink/8 bg-white p-6 shadow-card transition-all duration-300 ease-soft hover:-translate-y-1 hover:shadow-lift"
                >
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-display text-h3 text-teal">{program.name}</h3>
                    {program.status === 'soon' && (
                      <span class="label-caps shrink-0 rounded-full bg-camel/15 px-2.5 py-0.5 text-[0.65rem] text-camel">
                        Soon
                      </span>
                    )}
                  </div>
                  {program.length && (
                    <p class="mt-1 text-caption font-semibold text-sage">{program.length}</p>
                  )}
                  <p class="mt-3 flex-1 text-caption text-ink/75">{program.tagline}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-caption font-semibold text-teal">
                    Learn more
                    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="13 6 19 12 13 18" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <div class="pt-20"></div>
  <CTASection />
  <div class="pt-12"></div>
</BaseLayout>
