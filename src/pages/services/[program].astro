---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LineIcon from '../../components/LineIcon.astro';
import CTASection from '../../components/CTASection.astro';
import { programs, pillars, type Program } from '../../data/services';

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { program: program.slug },
    props: { program },
  }));
}

interface Props {
  program: Program;
}
const { program } = Astro.props;
const pillar = pillars.find((p) => p.key === program.pillar)!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: program.name,
  serviceType: `${pillar.word} — ${pillar.title}`,
  description: program.tagline,
  provider: { '@type': 'LocalBusiness', name: 'Hound & Home' },
  areaServed: 'Ararat, VA and the Mount Airy region',
};
---

<BaseLayout title={program.name} description={program.tagline} schema={schema}>
  <!-- Hero -->
  <section class="px-5 pt-14 sm:px-8 sm:pt-20">
    <div class="mx-auto max-w-3xl">
      <div class="reveal flex flex-wrap items-center gap-3 text-caption">
        <a href="/services" class="link-underline">Services</a>
        <span class="text-ink/30">/</span>
        <a href={`/services#${pillar.key}`} class="font-semibold text-sage">{pillar.word}</a>
        {
          program.status === 'soon' && (
            <span class="label-caps rounded-full bg-camel/15 px-3 py-1 text-camel">
              Coming soon
            </span>
          )
        }
      </div>
      <h1 class="reveal mt-4 font-display text-h1 text-teal sm:text-display">{program.name}</h1>
      <p class="reveal mt-4 text-body text-ink/75 sm:text-[1.125rem]">{program.tagline}</p>
      {
        program.length && (
          <p class="reveal mt-3 inline-flex items-center gap-2 text-caption font-semibold text-sage">
            <LineIcon name="compass" class="h-4 w-4" />
            {program.length}
          </p>
        )
      }
    </div>
  </section>

  <!-- Who it's for -->
  <section class="px-5 pt-12 sm:px-8 sm:pt-16">
    <div class="reveal mx-auto max-w-3xl rounded-2xl bg-sage-soft/50 p-7 sm:p-9">
      <p class="label-caps text-teal">Who it’s for</p>
      <p class="mt-3 text-body text-ink/80">{program.forWho}</p>
    </div>
  </section>

  <!-- What's included + goes home knowing -->
  <section class="px-5 pt-12 sm:px-8 sm:pt-16">
    <div class="mx-auto grid max-w-3xl gap-10 sm:grid-cols-2">
      <div class="reveal">
        <h2 class="font-display text-h3 text-teal">What’s included</h2>
        <ul class="mt-4 space-y-3">
          {
            program.includes.map((item) => (
              <li class="flex items-start gap-3 text-caption text-ink/80">
                <LineIcon name="paw" class="mt-0.5 h-5 w-5 shrink-0 text-sage" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal">
        <h2 class="font-display text-h3 text-teal">What your dog goes home knowing</h2>
        <ul class="mt-4 space-y-3">
          {
            program.goesHomeKnowing.map((item) => (
              <li class="flex items-start gap-3 text-caption text-ink/80">
                <LineIcon name="heart" class="mt-0.5 h-5 w-5 shrink-0 text-camel" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Support after -->
  <section class="px-5 pt-12 sm:px-8 sm:pt-16">
    <div class="reveal mx-auto flex max-w-3xl flex-col gap-4 rounded-2xl border border-ink/8 bg-white p-7 shadow-card sm:flex-row sm:items-center">
      <LineIcon name="house" class="h-10 w-10 shrink-0 text-teal" />
      <div>
        <h2 class="font-display text-h3 text-teal">The support that follows</h2>
        <p class="mt-1.5 text-caption text-ink/75">{program.supportAfter}</p>
      </div>
    </div>
  </section>

  <div class="pt-20"></div>
  <CTASection
    heading={program.status === 'soon'
      ? 'Want to be first to know?'
      : 'Is this the right fit for your dog?'}
    blurb={program.status === 'soon'
      ? 'Reach out and I’ll let you know the moment this opens. No pressure, just a heads-up.'
      : 'Let’s talk it through. Tell me about your dog and we’ll figure out the right next step together.'}
  />
  <div class="pt-12"></div>
</BaseLayout>
