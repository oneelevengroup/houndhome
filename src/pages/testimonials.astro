---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LineIcon from '../components/LineIcon.astro';
import CTASection from '../components/CTASection.astro';
import { testimonials } from '../data/testimonials';

const hasReal = testimonials.some((t) => !t.placeholder);
---

<BaseLayout
  title="Testimonials"
  description="Stories from families who trusted Hound & Home with their dogs."
>
  <PageHero
    eyebrow="In their words"
    title="Families who trusted the process."
    intro="The best measure of this work is how a dog and their family feel after. Real stories will live here as they come in."
  />

  {
    !hasReal && (
      <section class="px-5 pt-10 sm:px-8">
        <p class="reveal mx-auto max-w-xl rounded-full bg-camel/10 px-5 py-2.5 text-center text-caption text-ink/60">
          Placeholder stories below. Real client testimonials are being collected.
        </p>
      </section>
    )
  }

  <section class="px-5 pt-12 sm:px-8 sm:pt-16">
    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
      {
        testimonials.map((t) => (
          <figure class="reveal flex flex-col rounded-2xl border border-ink/8 bg-white p-7 shadow-card">
            <LineIcon name="paw" class="h-8 w-8 text-sage" />
            <blockquote class="mt-4 flex-1 text-body text-ink/85">“{t.quote}”</blockquote>
            <figcaption class="mt-6 border-t border-ink/8 pt-4 text-caption">
              <span class="font-semibold text-teal">{t.author}</span>
              <span class="text-ink/55"> · {t.dog}</span>
              <span class="mt-0.5 block text-[0.75rem] uppercase tracking-wide text-sage">
                {t.program}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <div class="pt-20"></div>
  <CTASection
    heading="Your dog’s story could be next."
    blurb="Let’s talk about where your dog is now and where you’d love them to be."
  />
  <div class="pt-12"></div>
</BaseLayout>
