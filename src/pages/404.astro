---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineIcon from '../components/LineIcon.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <section class="px-5 py-24 text-center sm:px-8 sm:py-32">
    <LineIcon name="paw" class="mx-auto h-14 w-14 text-sage" />
    <p class="mt-6 label-caps text-camel">404</p>
    <h1 class="mt-3 font-display text-h1 text-teal sm:text-display">
      This trail went cold.
    </h1>
    <p class="mx-auto mt-4 max-w-md text-body text-ink/75">
      The page you’re after isn’t here. Let’s get you back to familiar ground.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/services" class="btn btn-secondary">See the programs</a>
    </div>
  </section>
</BaseLayout>
