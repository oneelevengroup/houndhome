---
import BaseLayout from '../layouts/BaseLayout.astro';
import PawLoader from '../components/PawLoader.astro';
import LineIcon from '../components/LineIcon.astro';
import { site } from '../data/site';

const typeform = site.embeds.typeform;
const formWired = Boolean(typeform);
const year = new Date().getFullYear();
---

<BaseLayout
  title="New Site Coming Soon"
  description="Hound & Home is a boutique dog training, daycare, and boarding service located in Virginia and serving VA and NC, with convenient pick-up. We're open now; our new website is on its way."
  ogImage="/assets/brand/houndhome-logo.png"
  bare={true}
>
  <!-- Top service-area bar -->
  <div class="w-full bg-teal text-cream">
    <p class="mx-auto max-w-6xl px-5 py-2 text-center text-[0.72rem] uppercase tracking-[0.22em]">
      Serving Virginia &amp; North Carolina
    </p>
  </div>

  <div class="relative min-h-screen overflow-hidden">
    <!-- soft sage glow (logo is transparent, so it sits cleanly on top) -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[65vh]"
      style="background: radial-gradient(65% 55% at 50% 0%, rgba(148,169,140,0.20), transparent 72%);"
    >
    </div>

    <div class="mx-auto flex min-h-screen max-w-4xl flex-col items-center justify-center px-5 py-16 text-center sm:px-8">
      <!-- Logo (transparent) -->
      <h1 class="sr-only">Hound &amp; Home</h1>
      <img
        src="/assets/brand/houndhome-logo.png"
        alt="Hound &amp; Home — Training, Daycare, Boarding"
        width="725"
        height="900"
        class="h-auto w-64 sm:w-72"
      />

      <!-- Headline -->
      <h2 class="mt-8 whitespace-nowrap font-display text-teal text-[clamp(1rem,4.7vw,2.5rem)]">
        Training · Daycare · Boarding
      </h2>
      <p class="mt-4 max-w-xl text-body text-ink/75">
        Boutique dog training, daycare, and boarding from a trainer with thirteen
        years and a belief that no two dogs are the same. We are open and
        welcoming new pups now. Our brand new website is on its way, so leave your
        details below and we will be right in touch.
      </p>

      <!-- Primary CTA -->
      <a href="#inquire" class="inquire-btn group mt-8">
        <span class="relative z-10 flex items-center gap-2.5">
          <LineIcon name="paw" class="h-5 w-5" />
          Inquire Now
          <svg class="h-4 w-4 transition-transform duration-300 ease-soft group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </a>

      <!-- Convenient pick-up -->
      <div class="mt-6 inline-flex items-center gap-2.5 rounded-full bg-sage-soft/70 px-5 py-2.5 text-caption font-semibold text-teal">
        <LineIcon name="paw" class="h-5 w-5 shrink-0 text-teal" />
        Convenient pick-up available. We will come get your pup from you.
      </div>

      <!-- Paw-print loader -->
      <div class="mt-12 w-full max-w-2xl">
        <PawLoader />
      </div>

      <!-- Meet Taylor -->
      <section class="mt-20 w-full text-left sm:mt-24">
        <div class="grid items-center gap-8 sm:grid-cols-2 sm:gap-12">
          <img
            src="/assets/photos/meet-taylor.jpg"
            alt="Taylor Arnder standing with a group of dogs, including borzois, in a sunlit field"
            width="1199"
            height="1200"
            loading="lazy"
            class="w-full rounded-[1.75rem] shadow-card"
          />
          <div>
            <p class="label-caps text-camel">Meet the trainer</p>
            <h2 class="mt-3 font-display text-h2 text-teal">Meet Taylor</h2>
            <p class="mt-4 text-body text-ink/75">
              Taylor has spent thirteen years around dogs of every kind, from
              shelters and show dogs to sport dogs and a large daycare and boarding
              facility she ran as a general manager at nineteen. She digs into the
              why behind your dog’s behavior, works with every kind of dog, not
              just the easy ones, and treats yours the way she would want hers
              treated.
            </p>
            <p class="mt-5 text-caption font-semibold uppercase tracking-wide text-sage">
              Taylor Arnder · Owner
            </p>
          </div>
        </div>
      </section>

      <!-- Lead capture -->
      <div id="inquire" class="mt-16 w-full max-w-xl scroll-mt-8 sm:mt-20">
        {
          formWired ? (
            <div class="overflow-hidden rounded-2xl border border-ink/8 bg-white shadow-card">
              <iframe
                src={typeform}
                title="Get in touch with Hound & Home"
                loading="lazy"
                class="w-full"
                style="height:520px;border:0;"
              />
            </div>
          ) : (
            <div class="rounded-2xl border border-dashed border-teal/25 bg-white/70 p-8 text-center sm:p-10">
              <h3 class="font-display text-h3 text-teal">Ready to get started?</h3>
              <p class="mx-auto mt-2 max-w-md text-caption text-ink/70">
                Have a question or want to book your pup in? Our quick contact form
                lands here shortly. In the meantime, reach out directly and we will
                take great care of you both.
              </p>
              <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a href={site.phoneHref} class="btn btn-primary">Call or text {site.phone}</a>
              </div>
              <p class="mt-3 text-[0.72rem] uppercase tracking-wide text-ink/35">
                Contact form connecting soon
              </p>
            </div>
          )
        }
      </div>

      <!-- Minimal footer, no navigation -->
      <div class="mt-16 flex flex-col items-center gap-1 text-caption text-ink/55">
        <p>Located in Virginia</p>
        <p>
          <a href={site.phoneHref} class="link-underline">{site.phone}</a>
        </p>
        <p class="mt-3 text-[0.72rem] uppercase tracking-[0.18em] text-ink/35">
          &copy; {year} Hound &amp; Home · Est. 2020
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* "Inquire Now" CTA: teal gradient pill with a soft lift and a slow shimmer. */
  .inquire-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 0.95rem 2.1rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--cream);
    background: linear-gradient(135deg, var(--teal), var(--teal-deep));
    box-shadow: 0 6px 20px rgba(46, 74, 78, 0.22);
    transition:
      transform 0.3s var(--ease-soft),
      box-shadow 0.3s var(--ease-soft);
  }
  .inquire-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(46, 74, 78, 0.3);
  }
  .inquire-btn::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -40%;
    width: 35%;
    z-index: 0;
    background: linear-gradient(100deg, transparent, rgba(245, 241, 232, 0.45), transparent);
    transform: skewX(-20deg);
    animation: inquire-shimmer 3.6s ease-in-out infinite;
  }
  @keyframes inquire-shimmer {
    0% { left: -40%; }
    55%, 100% { left: 130%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .inquire-btn::before { animation: none; opacity: 0; }
    .inquire-btn:hover { transform: none; }
  }
</style>
