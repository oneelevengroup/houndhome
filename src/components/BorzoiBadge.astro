---
import BorzoiRunner from './BorzoiRunner.astro';
// Circular badge emblem echoing the new logo: a borzoi beneath a peaked roofline,
// inside a ring. The ring + roof are line-art; the borzoi reuses the filled
// galloping silhouette so it reads cleanly at any size. Colour via currentColor.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`relative ${className}`}>
  <svg
    viewBox="0 0 220 220"
    class="absolute inset-0 h-full w-full"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Ring -->
    <circle cx="110" cy="110" r="98" />
    <!-- Peaked roofline (the house motif) with short eaves -->
    <path d="M58 104 L110 62 L162 104" stroke-width="2.8" />
    <path d="M66 99 L66 120" />
    <path d="M154 99 L154 120" />
  </svg>

  <!-- Borzoi (filled) sitting under the roof -->
  <div class="absolute left-1/2 top-[54%] w-[56%] -translate-x-1/2">
    <BorzoiRunner class="h-auto w-full" />
  </div>

  <span class="sr-only">Hound &amp; Home emblem: a borzoi beneath a rooflined home</span>
</div>
