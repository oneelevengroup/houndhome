---
import { nav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-ink/5 bg-cream/85 backdrop-blur-md">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8"
    aria-label="Primary"
  >
    <a href="/" class="flex shrink-0 items-center" aria-label="Hound & Home, home">
      <img
        src="/assets/brand/hound-and-home-horizontal.png"
        alt="Hound & Home"
        width="220"
        height="64"
        class="h-11 w-auto sm:h-12"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'text-caption font-semibold tracking-wide transition-colors duration-200',
                isActive(item.href) ? 'text-teal' : 'text-ink/70 hover:text-teal',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:block">
      <a href="/booking" class="btn btn-primary !px-5 !py-2.5 text-caption">
        Start with a conversation
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-teal lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" hidden class="border-t border-ink/5 bg-cream lg:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col px-5 py-3 sm:px-8">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block border-b border-ink/5 py-3 text-base font-semibold',
                isActive(item.href) ? 'text-teal' : 'text-ink/80',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-4">
        <a href="/booking" class="btn btn-primary w-full">Start with a conversation</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      menu.hidden = open;
    });
  }
</script>
