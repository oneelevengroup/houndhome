---
import BorzoiRunner from './BorzoiRunner.astro';
// A borzoi galloping across a filling loading bar. Indeterminate loop (it is a
// "coming soon" flourish, not real progress). Reduced-motion users get a calm,
// static state instead of the run cycle.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`borzoi-loader mx-auto w-full max-w-sm ${className}`} aria-hidden="true">
  <!-- Runner rides above the leading edge of the fill -->
  <div class="runner-lane relative h-14">
    <div class="runner absolute bottom-0">
      <div class="bob text-teal">
        <BorzoiRunner class="h-12 w-auto" />
      </div>
    </div>
  </div>

  <!-- Track -->
  <div class="track relative h-2 overflow-hidden rounded-full bg-sage-soft">
    <div class="fill absolute inset-y-0 left-0 rounded-full bg-teal"></div>
  </div>

  <p class="mt-4 text-center label-caps text-sage">Fetching something good</p>
</div>

<style>
  .runner {
    left: 0;
    animation: run-across 3s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .bob {
    animation: run-bob 0.5s ease-in-out infinite;
  }
  .fill {
    width: 8%;
    animation: fill-track 3s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes run-across {
    0% { left: 0; }
    100% { left: calc(100% - 5.5rem); }
  }
  @keyframes fill-track {
    0% { width: 6%; }
    100% { width: 100%; }
  }
  @keyframes run-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .runner {
      left: calc(62% - 2.75rem);
      animation: none;
    }
    .bob { animation: none; }
    .fill {
      width: 62%;
      animation: none;
    }
  }
</style>
