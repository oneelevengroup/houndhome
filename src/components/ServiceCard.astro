---
import LineIcon from './LineIcon.astro';
import type { Pillar } from '../data/services';
interface Props {
  pillar: Pillar;
}
const { pillar } = Astro.props;
const href = `/services#${pillar.key}`;
---

<a
  href={href}
  class="reveal group relative flex flex-col rounded-2xl border border-ink/8 bg-white p-7 shadow-card transition-all duration-300 ease-soft hover:-translate-y-1 hover:shadow-lift"
>
  <div class="flex items-center justify-between">
    <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sage-soft/70">
      <LineIcon name={pillar.icon} class="h-6 w-6 text-teal" />
    </span>
    {
      pillar.status === 'soon' && (
        <span class="label-caps rounded-full bg-camel/15 px-3 py-1 text-[0.7rem] text-camel">
          Coming soon
        </span>
      )
    }
  </div>

  <h3 class="mt-5 font-display text-h2 text-teal">{pillar.word}</h3>
  <p class="mt-0.5 text-caption font-semibold uppercase tracking-wide text-sage">
    {pillar.title}
  </p>
  <p class="mt-3 flex-1 text-body text-ink/75">{pillar.summary}</p>

  <span class="mt-6 inline-flex items-center gap-2 text-caption font-semibold text-teal">
    Explore {pillar.word}
    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="13 6 19 12 13 18"></polyline>
    </svg>
  </span>
</a>
