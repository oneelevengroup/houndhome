---
// SIGNATURE ELEMENT (CLAUDE.md §2): the rooflined house-arch from the logo,
// used as a recurring structural frame. Masks imagery inside the house
// silhouette and draws the peaked outline on top in one consistent stroke.
//
// Usage:
//   <HouseArch image="/path.jpg" alt="..." />        — masked photo
//   <HouseArch><!-- slotted content --></HouseArch>  — framed content
let _id = (globalThis as any).__houseArchId ?? 0;
(globalThis as any).__houseArchId = _id + 1;

interface Props {
  image?: string;
  alt?: string;
  class?: string;
  outline?: 'teal' | 'sage' | 'cream';
  showOutline?: boolean;
  /** decorative camel dot + sage leaf, like the logo */
  marks?: boolean;
}
const {
  image,
  alt = '',
  class: className = '',
  outline = 'teal',
  showOutline = true,
  marks = true,
} = Astro.props;

const clipId = `house-clip-${_id}`;
const strokeColor =
  outline === 'cream' ? '#F5F1E8' : outline === 'sage' ? '#94A98C' : '#2E4A4E';

// Rounded-corner house silhouette echoing the logo (peaked roof, soft base).
const housePath =
  'M47.5 5.2 Q50 3.4 52.5 5.2 L91 35 Q94 37.4 94 41.5 L94 91 Q94 99 86 99 L14 99 Q6 99 6 91 L6 41.5 Q6 37.4 9 35 Z';
---

<div class={`house-arch relative ${className}`}>
  <svg
    viewBox="0 0 100 104"
    class="h-full w-full"
    role={image ? 'img' : 'presentation'}
    aria-label={image ? alt : undefined}
    aria-hidden={image ? undefined : 'true'}
  >
    <defs>
      <clipPath id={clipId} clipPathUnits="userSpaceOnUse">
        <path d={housePath} />
      </clipPath>
    </defs>

    {
      image ? (
        <image
          href={image}
          x="0"
          y="0"
          width="100"
          height="104"
          preserveAspectRatio="xMidYMid slice"
          clip-path={`url(#${clipId})`}
        />
      ) : (
        <rect
          x="0"
          y="0"
          width="100"
          height="104"
          fill="#DCE3D6"
          clip-path={`url(#${clipId})`}
        />
      )
    }

    {
      marks && (
        <g clip-path={`url(#${clipId})`}>
          <circle cx="22" cy="40" r="6" fill="#C9A57B" opacity="0.92" />
          <path
            d="M74 99 Q74 86 88 86 Q88 99 74 99 Z"
            fill="#94A98C"
            opacity="0.85"
          />
        </g>
      )
    }

    {
      showOutline && (
        <path
          d={housePath}
          fill="none"
          stroke={strokeColor}
          stroke-width="1.4"
          stroke-linejoin="round"
        />
      )
    }
  </svg>

  {
    !image && (
      <div class="absolute inset-0 flex items-center justify-center px-[14%] pb-[10%] pt-[20%] text-center">
        <slot />
      </div>
    )
  }
</div>
