---
// Loading indicator: a trail of paw prints that light up in a left-to-right
// wave. Alternating tilt + vertical offset reads like a walking trail.
// Reduced-motion users get a calm, static row.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const COUNT = 6;
---

<div class={`paw-loader ${className}`} aria-hidden="true">
  <div class="flex items-center justify-center gap-3 sm:gap-4">
    {
      Array.from({ length: COUNT }).map((_, i) => (
        <span
          class="paw"
          style={`animation-delay:${(i * 0.16).toFixed(2)}s; --tilt:${i % 2 ? 10 : -10}deg; --lift:${i % 2 ? '5px' : '-1px'};`}
        >
          <svg viewBox="0 0 24 24" class="h-6 w-6 sm:h-7 sm:w-7" fill="currentColor" aria-hidden="true">
            <ellipse cx="6.2" cy="10" rx="2" ry="2.7" />
            <ellipse cx="10.3" cy="6.2" rx="2.1" ry="2.9" />
            <ellipse cx="14.6" cy="6.1" rx="2.1" ry="2.9" />
            <ellipse cx="18.6" cy="9.6" rx="2" ry="2.7" />
            <path d="M12 21.4 C 8.1 21.4 6 18.7 6 15.9 C 6 13.1 8.8 12 12 12 C 15.2 12 18 13.1 18 15.9 C 18 18.7 15.9 21.4 12 21.4 Z" />
          </svg>
        </span>
      ))
    }
  </div>
  <p class="mt-5 text-center label-caps text-sage">Fetching something good</p>
</div>

<style>
  .paw-loader {
    color: var(--teal);
  }
  .paw {
    display: inline-flex;
    opacity: 0.18;
    transform: translateY(var(--lift)) rotate(var(--tilt));
    animation: paw-wave 1.9s ease-in-out infinite;
  }
  @keyframes paw-wave {
    0%, 68%, 100% { opacity: 0.18; }
    34% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .paw {
      opacity: 0.5;
      animation: none;
    }
  }
</style>
