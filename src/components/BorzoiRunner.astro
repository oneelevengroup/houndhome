---
// Galloping borzoi silhouette (single-line brand style), facing right.
// Torso, neck, head and plumed tail as one fill; legs as tapered strokes in an
// extended double-suspension gallop. Colour via currentColor.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 220 120"
  class={className}
  role="img"
  aria-label="A borzoi running"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Rear legs (behind body), extended back -->
  <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
    <path d="M84 62 C 78 80, 70 90, 58 102" />
    <path d="M74 60 C 64 78, 52 88, 38 100" />
  </g>

  <!-- Body + neck + head + tail -->
  <path
    d="M206 45
       C 199 41, 191 41, 183 43
       C 177 31, 168 27, 160 31
       L 156 20
       C 159 31, 151 35, 146 41
       C 130 45, 118 35, 96 35
       C 78 35, 66 41, 56 45
       C 44 41, 30 41, 20 51
       C 13 56, 12 63, 19 62
       C 31 57, 45 55, 57 57
       C 67 59, 73 63, 81 66
       C 93 80, 109 82, 121 71
       C 131 67, 141 67, 151 65
       C 161 59, 171 57, 179 55
       C 188 53, 197 51, 206 45 Z"
  />

  <!-- Front legs, reaching forward -->
  <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
    <path d="M150 63 C 158 78, 172 86, 190 98" />
    <path d="M142 65 C 150 82, 160 90, 172 102" />
  </g>
</svg>
